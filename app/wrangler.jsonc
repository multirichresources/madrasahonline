{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "madrasah-online",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "madrasah-db",
      // Tukar kepada ID sebenar selepas: npx wrangler d1 create madrasah-db
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "triggers": { "crons": ["0 19 * * *"] },
  "vars": { "HASH_ITERATIONS": "10000" }
  // Rahsia (tetapkan dengan: npx wrangler secret put NAMA):
  //   SETUP_KEY  — kunci sekali guna untuk cipta admin pertama (min 16 aksara)
}
